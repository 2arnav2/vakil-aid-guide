# Optional: Google AI Studio (Gemini) key for the optional cloud fallback.
# For local development only. Never commit a real key.
VITE_GOOGLE_AI_API_KEY=

# Optional: default Gemini model.
VITE_GEMINI_MODEL=gemini-3.8-flash

# Optional: point to a backend proxy instead of calling Google directly.
# Leave empty to use https://generativelanguage.googleapis.com
VITE_GEMINI_BASE_URL=
